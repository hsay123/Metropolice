# Copy to .env.local and adjust.
#
# Mock mode: the app runs entirely against mocks/ — no backend, no chain.
# Set to false to use the real Next.js API routes and Monad testnet.
NEXT_PUBLIC_USE_MOCKS=true

# Simulated mock failure rate (0-1). 0 keeps the demo clean; raise it to rehearse
# error and retry states. Only applies in mock mode.
NEXT_PUBLIC_MOCK_FAILURE_RATE=0

# Privy app id. Set this to turn on real email and wallet sign-in. When it is set
# the login screen uses Privy even in mock mode, so you can rehearse the real flow.
# Required when NEXT_PUBLIC_USE_MOCKS=false.
NEXT_PUBLIC_PRIVY_APP_ID=

# Monad testnet RPC override (optional).
NEXT_PUBLIC_MONAD_RPC_URL=
